{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lexinote.app/schemas/lexinote-plugin.manifest.schema.json",
  "title": "LexiNote plugin manifest",
  "description": "Manifest for a native LexiNote plugin (format 'lexinote-plugin'). Obsidian plugins use their own manifest shape and are validated separately by the compatibility path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "id",
    "name",
    "version",
    "apiVersion",
    "main"
  ],
  "properties": {
    "format": {
      "description": "Manifest family marker.",
      "const": "lexinote-plugin"
    },
    "formatVersion": {
      "description": "Manifest schema version; only 1 is supported.",
      "type": "integer",
      "const": 1
    },
    "id": {
      "description": "Stable, globally unique plugin id. Lowercase ASCII letters/digits at both ends.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "name": {
      "description": "Human readable name shown in settings and the command palette.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "description": "Semantic version of the plugin.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "apiVersion": {
      "description": "LexiNote plugin API version the bundle targets (1.x).",
      "type": "string",
      "pattern": "^1(?:\\.\\d+){0,2}$"
    },
    "main": {
      "description": "Bundle entry file, relative to the plugin directory.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "author": {
      "type": "string",
      "maxLength": 128
    },
    "capabilities": {
      "description": "Host capabilities the plugin requests. Unknown strings are rejected.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "vault.read",
          "vault.write",
          "notes.metadata.read",
          "editor.read",
          "editor.write",
          "workspace.views",
          "ui.notice",
          "ui.modal",
          "ui.commands",
          "ai.inference",
          "ui.views",
          "plugin.storage",
          "network"
        ]
      },
      "uniqueItems": true,
      "default": []
    },
    "targets": {
      "description": "Optional device targets; informational for the installer.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": ["harmonyos"]
    },
    "minHostVersion": {
      "description": "Minimum LexiNote host version required.",
      "type": "string"
    },
    "isDesktopOnly": {
      "description": "Desktop-only plugins are refused on HarmonyOS.",
      "type": "boolean",
      "default": false
    }
  },
  "examples": [
    {
      "format": "lexinote-plugin",
      "formatVersion": 1,
      "id": "example.hello",
      "name": "Hello LexiNote",
      "version": "1.0.0",
      "apiVersion": "1.0",
      "main": "main.js",
      "description": "Minimal example plugin.",
      "author": "LexiNote",
      "capabilities": [
        "vault.read",
        "vault.write",
        "plugin.storage",
        "ui.commands",
        "ui.notice"
      ]
    }
  ]
}
